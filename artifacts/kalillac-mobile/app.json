{
  "expo": {
    "name": "Kalillac",
    "slug": "kalillac-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-placeholder.png",
    "scheme": "kalillac-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/brand/icon-placeholder.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-foreground-placeholder.png",
        "backgroundColor": "#F7F8F9"
      }
    },
    "web": {
      "favicon": "./assets/brand/favicon-placeholder.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", {
        "backgroundColor": "#F7F8F9",
        "dark": {
          "backgroundColor": "#0B0D12"
        }
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
